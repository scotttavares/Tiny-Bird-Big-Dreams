DEFINE SCHEMA

    RECORD TYPE CD_Notebook (
        "___createTime"         TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"          REFERENCE QUERYABLE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"         REFERENCE QUERYABLE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt          BYTES,
        CD_moveReceipt_ckAsset  ASSET,
        CD_id                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset        ASSET,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_updatedAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_themeRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_themeRaw_ckAsset     ASSET,
        CD_isStarter            INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Page (
        "___createTime"           TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"            REFERENCE QUERYABLE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"           REFERENCE QUERYABLE,
        "___recordID"             REFERENCE QUERYABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt            BYTES,
        CD_moveReceipt_ckAsset    ASSET,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset          ASSET,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_updatedAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_sortIndex              INT64 QUERYABLE SORTABLE,
        CD_drawingData            BYTES,
        CD_drawingData_ckAsset    ASSET,
        CD_paperStyleRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_paperStyleRaw_ckAsset  ASSET,
        CD_paperTintRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_paperTintRaw_ckAsset   ASSET,
        CD_itemsData              BYTES,
        CD_itemsData_ckAsset      ASSET,
        CD_weatherRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_weatherRaw_ckAsset     ASSET,
        CD_fieldNotes             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fieldNotes_ckAsset     ASSET,
        CD_voiceNotesData         BYTES,
        CD_voiceNotesData_ckAsset ASSET,
        CD_locationName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_locationName_ckAsset   ASSET,
        CD_fieldDate              TIMESTAMP QUERYABLE SORTABLE,
        CD_tags                   BYTES,
        CD_tags_ckAsset           ASSET,
        CD_thumbnailData          BYTES,
        CD_thumbnailData_ckAsset  ASSET,
        CD_notebook               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reference              STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ReferenceAsset (
        "___createTime"               TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"                REFERENCE QUERYABLE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"               REFERENCE QUERYABLE,
        "___recordID"                 REFERENCE QUERYABLE,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                BYTES,
        CD_moveReceipt_ckAsset        ASSET,
        CD_kindRaw                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset            ASSET,
        CD_relativeImagePath          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_relativeImagePath_ckAsset  ASSET,
        CD_notes                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset              ASSET,
        CD_createdAt                  TIMESTAMP QUERYABLE SORTABLE,
        CD_page                       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MediaFile (
        "___createTime"         TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"          REFERENCE QUERYABLE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy"         REFERENCE QUERYABLE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt          BYTES,
        CD_moveReceipt_ckAsset  ASSET,
        CD_path                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_path_ckAsset         ASSET,
        CD_data                 BYTES,
        CD_data_ckAsset         ASSET,
        CD_createdAt            TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
